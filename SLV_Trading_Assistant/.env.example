# SLV Trading Assistant — environment variables
# Copy this file to .env and fill in your values.

# FRED API key — register free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: override log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Schwab API credentials — register your app at https://developer.schwab.com/
# Set the redirect URI to https://127.0.0.1 in the Schwab developer portal.
SCHWAB_CLIENT_ID=your_schwab_client_id_here
SCHWAB_CLIENT_SECRET=your_schwab_client_secret_here
# Optional overrides (defaults shown):
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# SCHWAB_TOKEN_PATH=data/schwab_token.json

# NewsAPI.org — register free at https://newsapi.org/register
# Fetches silver/SLV/gold headlines from hundreds of sources.
NEWSAPI_API_KEY=your_newsapi_key_here

# Finnhub — register free at https://finnhub.io/register
# Fetches company news for SLV and GLD (last 7 days).
FINNHUB_API_KEY=your_finnhub_key_here
